.github.io/assets/images/st_0001.png\" alt=\"stat\">\n                            <span class=\"display-text ms-1\">30%</span>\n                        </div><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"1 turn\">\n                            <img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0002.png\" alt=\"stat\">\n                            <span class=\"display-text ms-1\">50%</span>\n                        </div></div>\n                                    </div>\n                                </div>\n                                <div class=\"sa-lv-container\">\n                                    <div class=\"row sa-20-bonus\" style=\"display: none;\">\n                                        <div class=\"col\">\n                                            <hr class=\"divider py bg-secondary\">\n                                            <div class=\"text-center py-1\">SA Lv 20: Super Attack +30%</div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>"
