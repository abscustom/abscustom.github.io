  "activeBlocksHTML": [
    "<div class=\"row active-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-teq dokkan-card\">\n    <!-- p-0 ensures the background colors touch the exact edges of the border -->\n    <div class=\"col p-0\">\n      \n      <!-- HEADER ROW -->\n      <div class=\"row padding-top-bottom-10 bg-teq m-0 position-relative d-flex align-items-center\">\n        <!-- 1. Label strictly locked to the left -->\n        <div class=\"position-absolute start-0 w-auto\" style=\"padding-left: 15px;\">\n          <b class=\"active-type-label\">Active Skill</b>\n        </div>\n        <!-- 2. Skill Name perfectly centered -->\n        <div class=\"col text-center px-5\">\n          <b class=\"active-display-name\">Death Ball: Imperial Cataclysm</b>\n        </div>\n      </div>\n\n      <!-- BODY ROW -->\n      <div class=\"row padding-top-bottom-5 bg-teq-2 m-0\">\n        <!-- 3. All text below centered -->\n        <div class=\"col text-center\">\n          <div class=\"row padding-top-5\">\n            <div class=\"col active-display-effect\">Massively raises ATK temporarily and causes ultimate damage to enemy; Ki +24, DEF 200% and directs enemy's attack towards the character; All attacks become critical hits and ATK 500% for 1 turn</div>\n          </div>\n\n          <!-- Divider line with toggle class -->\n          <div class=\"row active-divider-row\">\n            <div class=\"col\">\n              <hr class=\"divider py bg-secondary\">\n            </div>\n          </div>\n\n          <div class=\"row padding-bottom-5 active-condition-row\">\n            <div class=\"col\">\n              <div class=\"row\">\n                <div class=\"col\"><b>Activation Condition(s)</b></div>\n              </div>\n              <div class=\"row\">\n                <div class=\"col active-display-condition\">Can be activated when there is another \"Terrifying Conquerors\" Category ally on the team starting from the 5th turn from the character's entry turn Or when HP is 50% or lessStarting from the 5th turn from the start of battle (once only)</div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n    </div>\n  <img class=\"active-display-icon d-none\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_01.png\"></div>"
