  "saBlocksHTML": [
    "<div class=\"row sa-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-teq dokkan-card\">\n        <div class=\"col\">\n            <div class=\"row padding-top-bottom-10 bg-teq dokkan-card\">\n                <div class=\"col-sm-2\"><b><span class=\"sa-type-label\">Super Attack</span></b></div>\n                <div class=\"col-sm-8\" style=\"display: flex; justify-content: center; align-items: center;\">\n                    <!-- Use Classes here -->\n                    <img class=\"sa-display-icon\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_01.png\">\n                    <b class=\"sa-display-name\">Imperial Death Beam</b>\n                </div>\n            </div>\n            <div class=\"row padding-top-bottom-5 bg-teq-2 dokkan-card\">\n                <div class=\"col padding-top-bottom-5\">\n                    <div class=\"sa-display-effects-list\"><div class=\"row\"><div class=\"col\">Greatly Raises ATK for 2 turns, causes colossal damage to enemy and lowers ATK &amp; DEF</div></div></div>\n\n                    <!-- 1. ACTIVATION CONDITION (Hidden by default, shows above SA logo when active) -->\n                    <div class=\"activation-row d-none\">\n                        <hr class=\"divider py bg-secondary\">\n                        <div class=\"row\">\n                            <div class=\"col text-center italic py-1\">\n                                <div class=\"activation-text\">Activation Conditions</div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- 2. SA STATS LOGO (Always visible, stays below activation text) -->\n                    <div class=\"row\">\n                        <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                            <div class=\"stats-container row\"><div class=\"col sa-stat-row\" data-target=\"self\" d