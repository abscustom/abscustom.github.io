  "activeBlocksHTML": [
    "<div class=\"row active-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <!-- p-0 ensures the background colors touch the exact edges of the border -->\n                  <div class=\"col p-0\">\n\n                    <!-- HEADER ROW -->\n                    <div class=\"row padding-top-bottom-10 bg-agl m-0 position-relative d-flex align-items-center\">\n                      <!-- 1. Label strictly locked to the left -->\n                      <div class=\"position-absolute start-0 w-auto\" style=\"padding-left: 15px;\">\n                        <b class=\"active-type-label\">Active Skill</b>\n                      </div>\n                      <!-- 2. Skill Name perfectly centered -->\n                      <div class=\"col text-center px-5\">\n                        <b class=\"active-display-name\">Transformation</b>\n                      </div>\n                    </div>\n\n                    <!-- BODY ROW -->\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 m-0\">\n                      <!-- 3. All text below centered -->\n                      <div class=\"col text-center\">\n                        <div class=\"row padding-top-5\">\n                          <div class=\"col active-display-effect\">Transforms</div>\n                        </div>\n\n                        <!-- Divider line with toggle class -->\n                        <div class=\"row active-divider-row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                          </div>\n                        </div>\n\n                        <div class=\"row padding-bottom-5 active-condition-row\">\n                          <div class=\"col\">\n                            <div class=\"row\">\n                              <div class=\"col\"><b>Activation Condition(s)</b></div>\n                            </div>\n                            <div class=\"row\">\n                              <div class=\"col active-display-condition\">Can be activated after the character has received 5 attacks in battle (once only)</div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n\n                  </div>\n                </div>"
  ],
  "saBlocksHTML": [
    "<div class=\"row sa-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <div class=\"col\">\n                    <div class=\"row padding-top-bottom-10 bg-agl dokkan-card\">\n                      <div class=\"col-sm-2\"><b><span class=\"sa-type-label\">Super Attack</span></b></div>\n                      <div class=\"col-sm-8\" style=\"display: flex; justify-content: center; align-items: center;\">\n                        <!-- Use Classes here -->\n                        <img class=\"sa-display-icon\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_etc.png\">\n                        <b class=\"sa-display-name\">Slash Arrow Kick</b>\n                      </div>\n                    </div>\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 dokkan-card\">\n                      <div class=\"col padding-top-bottom-5\">\n                        <div class=\"sa-display-effects-list\"><div class=\"row\"><div class=\"col\">Raises ATK &amp; DEF by 44% and causes immense damage to enemy</div></div></div>\n\n                        <!-- 1. ACTIVATION CONDITION (Hidden by default, shows above SA logo when active) -->\n                        <div class=\"activation-row d-none\">\n                          <hr class=\"divider py bg-secondary\">\n                          <div class=\"row\">\n                            <div class=\"col text-center italic py-1\">\n                              <div class=\"activation-text\">Activation Conditions</div>\n                            </div>\n                          </div>\n                        </div>\n\n                        <!-- 2. SA STATS LOGO (Always visible, stays below activation text) -->\n                        <div class=\"row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                            <div class=\"stats-container row\"><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"4 turns\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0001.png\"><span class=\"display-text ms-1\">44%</span></div><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"4 turns\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0002.png\"><span class=\"display-text ms-1\">44%</span></div></div>\n                          </div>\n                        </div>\n\n                        <!-- 3. SA LV 20 TEXT (Below SA Logo by default, hides when Activation toggled on) -->\n                        <div class=\"sa-lv-container\">\n                          <div class=\"row sa-20-bonus\" style=\"display: none;\">\n                            <div class=\"col\">\n                              <hr class=\"divider py bg-secondary\">\n                              <div class=\"text-center py-1\">SA Lv 20: Super Attack +30%</div>\n                            </div>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div>\n                  </div>\n                </div>"
  ],
  "containers": {
    "passiveCard": "<div id=\"card-sec-1\"><strong id=\"card-header-text-1\" style=\"display:block; margin-top:0px;\" class=\"\">Basic effect(s)</strong><ul id=\"card-ul-1\"><li>Ki +5, ATK &amp; DEF 350%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Guards all attacks</li><li>Damage reduction rate 40%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Launches an additional Super Attack</li><li>Randomly changes Ki Spheres of a certain Type to Rainbow Ki Spheres</li></ul></div><div id=\"card-sec-2\"><strong id=\"card-header-text-2\" style=\"display:block; margin-top:0px;\" class=\"\">When receiving a Super Attack for the 1st time within the turn</strong><ul id=\"card-ul-2\"><li>Evades enemy's attack</li></ul></div><div id=\"card-sec-3\"><strong id=\"card-header-text-3\" style=\"display:block; margin-top:0px;\" class=\"\">For every Rainbow Ki Sphere obtained</strong><ul id=\"card-ul-3\"><li>Damage reduction rate 7%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Launches an additional attack that has a great chance of becoming a Super Attack (up to 3 time within a turn)</li></ul></div><div id=\"card-sec-4\"><strong id=\"card-header-text-4\" style=\"display:block; margin-top:0px;\" class=\"\">After evading an attack</strong><ul id=\"card-ul-4\"><li class=\"\"><img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_icon_02.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\">All allies' Ki +1 and DEF 10%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li></ul></div><div id=\"card-sec-5\"><strong id=\"card-header-text-5\" style=\"display:block; margin-top:0px;\" class=\"\">When attacking with 18 or more Ki</strong><ul id=\"card-ul-5\"><li>Performs a critical hit</li><li>Launches an additional Super Attack</li></ul></div>",
