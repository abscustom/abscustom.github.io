  "activeBlocksHTML": [
    "<div class=\"row active-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <!-- p-0 ensures the background colors touch the exact edges of the border -->\n                  <div class=\"col p-0\">\n\n                    <!-- HEADER ROW -->\n                    <div class=\"row padding-top-bottom-10 bg-agl m-0 position-relative d-flex align-items-center\">\n                      <!-- 1. Label strictly locked to the left -->\n                      <div class=\"position-absolute start-0 w-auto\" style=\"padding-left: 15px;\">\n                        <b class=\"active-type-label\">Active Skill</b>\n                      </div>\n                      <!-- 2. Skill Name perfectly centered -->\n                      <div class=\"col text-center px-5\">\n                        <b class=\"active-display-name\">Transformation</b>\n                      </div>\n                    </div>\n\n                    <!-- BODY ROW -->\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 m-0\">\n                      <!-- 3. All text below centered -->\n                      <div class=\"col text-center\">\n                        <div class=\"row padding-top-5\">\n                          <div class=\"col active-display-effect\">Transforms</div>\n                        </div>\n\n                        <!-- Divider line with toggle class -->\n                        <div class=\"row active-divider-row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                          </div>\n                        </div>\n\n                        <div class=\"row padding-bottom-5 active-condition-row\">\n                          <div class=\"col\">\n                            <div class=\"row\">\n                              <div class=\"col\"><b>Activation Condition(s)</b></div>\n                        