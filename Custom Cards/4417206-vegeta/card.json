  "saBlocksHTML": [
    "<div class=\"row sa-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <div class=\"col\">\n                    <div class=\"row padding-top-bottom-10 bg-agl dokkan-card\">\n                      <div class=\"col-sm-2\"><b><span class=\"sa-type-label\">Super Attack</span></b></div>\n                      <div class=\"col-sm-8\" style=\"display: flex; justify-content: center; align-items: center;\">\n                        <!-- Use Classes here -->\n                        <img class=\"sa-display-icon\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_etc.png\">\n                        <b class=\"sa-display-name\">Slash Arrow Kick</b>\n                      </div>\n                    </div>\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 dokkan-card\">\n                      <div class=\"col padding-top-bottom-5\">\n                        <div class=\"sa-display-effects-list\"><div class=\"row\"><div class=\"col\">Raises ATK &amp; DEF by 44% for 4 turns and causes immense damage to enemy</div></div></div>\n\n                        <!-- 1. ACTIVATION CONDITION (Hidden by default, shows above SA logo when active) -->\n                        <div class=\"activation-row d-none\">\n                          <hr class=\"divider py bg-secondary\">\n                          <div class=\"row\">\n                            <div class=\"col text-center italic py-1\">\n                              <div class=\"activation-text\">Activation Conditions</div>\n                            </div>\n                          </div>\n                        </div>\n\n                        <!-- 2. SA STATS LOGO (Always visible, stays below activation text) -->\n                        <div class=\"row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                            <div class=\"stats-container row\"><div class=\"col sa-stat-row\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0001.png\"><span class=\"display-text ms-1\">44%</span></div><div class=\"col sa-stat-row\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0002.png\"><span class=\"display-text ms-1\">44%</span></div></div>\n                          </div>\n                        </div>\n\n                        <!-- 3. SA LV 20 TEXT (Below SA Logo by default, hides when Activation toggled on) -->\n                        <div class=\"sa-lv-container\">\n                          <div class=\"row sa-20-bonus\" style=\"display: none;\">\n                            <div class=\"col\">\n                              <hr class=\"divider py bg-secondary\">\n                              <div class=\"text-center py-1\">SA Lv 20: Super Attack +30%</div>\n                            </div>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div>\n                  </div>\n                </div>"
  ],
  "containers": {
    "passiveCard": "<div id=\"card-sec-1\"><strong id=\"card-header-text-1\" style=\"display:block; margin-top:0px;\" class=\"\">Basic effect(s)</strong><ul id=\"card-ul-1\"><li>Ki +5, ATK &amp; DEF 350%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Guards all attacks</li><li>Damage reduction rate 40%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Launches an additional Super Attack</li><li>Randomly changes Ki Spheres of a certain Type to Rainbow Ki Spheres</li></ul></div><div id=\"card-sec-2\"><strong id=\"card-header-text-2\" style=\"display:block; margin-top:0px;\" class=\"\">When receiving a Super Attack for the 1st time within the turn</strong><ul id=\"card-ul-2\"><li>Evades enemy's attack</li></ul></div><div id=\"card-sec-3\"><strong id=\"card-header-text-3\" style=\"display:block; margin-top:0px;\" class=\"\">For every Rainbow Ki Sphere obtained</strong><ul id=\"card-ul-3\"><li>Damage reduction rate 7%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li><li>Launches an additional attack that has a great chance of becoming a Super Attack (up to 3 time within a turn)</li></ul></div><div id=\"card-sec-4\"><strong id=\"card-header-text-4\" style=\"display:block; margin-top:0px;\" class=\"\">After evading an attack</strong><ul id=\"card-ul-4\"><li><img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_icon_02.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\">All allies' Ki +1 and DEF 10%<img src=\"https://abscustom.github.io/assets/images/passive_skill_dialog_arrow01.png\" style=\"height:14px; vertical-align:middle; margin:0 2px; transform:translateY(-1.5px);\"></li></ul></div><div id=\"card-sec-5\"><strong id=\"card-header-text-5\" style=\"display:block; margin-top:0px;\" class=\"\">When attacking with 18 or more Ki</strong><ul id=\"card-ul-5\"><li>Performs a critical hit</li><li>Launches an additional Super Attack</li></ul></div>",
    "passiveSidebar": "\n        <div id=\"side-sec-1\" style=\"background:#27272a; border:1px solid #3f3f46; padding:10px; margin-top:10px; border-radius:6px;\">\n            <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n                <b style=\"font-size: 12px; color: #a1a1aa; cursor:pointer;\" onclick=\"toggleSectionCollapse(1, document.getElementById('side-toggle-btn-1'))\">SECTION 1</b>\n                <div style=\"display:flex; gap: 4px;\">\n                    <button id=\"side-toggle-btn-1\" class=\"gui-minimize-btn\" onclick=\"toggleSectionCollapse(1, this)\" title=\"Collapse Section\">−</button>\n                    <button class=\"gui-minimize-btn\" onclick=\"moveSection(1, -1)\" title=\"Move Up\">↑</button>\n                    <button class=\"gui-minimize-btn\" onclick=\"moveSection(1, 1)\" title=\"Move Down\">↓</button>\n                    <button onclick=\"confirmDeleteSection(this, 1)\" title=\"Delete\" style=\"background:#ef4444; color:white; border:none; width:22px; height:22px; font-size:12px; cursor:pointer; font-weight:bold; border-radius:3px; display:flex; justify-content:center; align-items:center;\">×</button>\n                </div>\n            </div>\n            <div id=\"side-content-1\">\n                <!-- Header Input & Header Debuff Shortcuts -->\n                <div style=\"margin-top:6px; margin-bottom:4px;\">\n                    <input type=\"text\" id=\"input-sec-hdr-1\" oninput=\"updateHeader(1, this.value)\" value=\"Basic effect(s)\" class=\"form-control form-control-sm mb-1\">\n                    <div style=\"display:flex; gap:3px; width:100%; flex-wrap:wrap; margin-bottom:6px;\">\n                        <span style=\"font-size:9px; color:#888; align-self:center; font-weight:bold; margin-right:2px;\">Header:</span>\n                        <button onclick=\"insertShortcut('input-sec-hdr-1', ':atk_down:')\" title=\"ATK Down\" style=\"font-size:9px; padding:1px 4px; background:#1e293b; color:#f87171; border:1px solid #ef4444; border-radius:3px; cursor:pointer;\">ATK↓</button>\n                        <button onclick=\"insertShortcut('input-sec-hdr-1', ':def_down:')\" title=\"DEF Down\" style=\"font-size:9px; padding:1px 4px; background:#1e293b; color:#38bdf8; border:1px solid #3b82f6; border-radius:3px; cursor:pointer;\">DEF↓</button>\n                        <button onclick=\"insertShortcut('input-sec-hdr-1', ':stun:')\" title=\"Stun\" style=\"font-size:9px; padding:1px 4px; background:#1e293b; color:#facc15; border:1px solid #eab308; border-radius:3px; cursor:pointer;\">Stun</button>\n                        <button onclick=\"insertShortcut('input-sec-hdr-1', ':seal:')\" title=\"Seal\" style=\"font-size:9px; padding:1px 4px; background:#1e293b; color:#c084fc; border:1px solid #a855f7; border-radius:3px; cursor:pointer;\">Seal</button>\n                        <button onclick=\"insertShortcut('input-sec-hdr-1', ':break:')\" title=\"Action Break\" style=\"font-size:9px; padding:1px 4px; background:#1e293b; color:#fb923c; border:1px solid #f97316; border-radius:3px; cursor:pointer;\">Break</button>\n                    </div>\n                </div>\n\n                <textarea id=\"input-sec-1\" oninput=\"updateSection(1, this.value)\" class=\"form-control form-control-sm mb-2\" rows=\"6\" placeholder=\"Type effects here... Press Enter for a new line.\" value=\"- Ki +5, ATK &amp; DEF 350%:up:\n- Guards all attacks\n- Damage reduction rate 40%:up:\n- Launches an additional Super Attack\n- Randomly changes Ki Spheres of a certain Type to Rainbow Ki Spheres\">- Ki +5, ATK &amp; DEF 350%:up:\n- Guards all attacks\n- Damage reduction rate 40%:up:\n- Launches an additional Super Attack\n- Randomly changes Ki Spheres of a certain Type to Rainbow Ki Spheres</textarea>\n                \n                <!-- Text Area Shortcuts: Dialog Icons -->\n                <div style=\"display:flex; gap: 3px; width: 100%; flex-wrap:wrap; margin-bottom:3px;\">\n                    <button onclick=\"insertShortcut('input-sec-1', ':up:')\" title=\"Green Up Arrow\" class=\"btn-icon-tool\" style=\"color:#00ffcc; font-size: 12px; padding: 2px 4px; flex: 1;\">↑</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':down:')\" title=\"Self debuff arrow\" class=\"btn-icon-tool\" style=\"color:#ff4444; font-size: 12px; padding: 2px 4px; flex: 1;\">↓</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':ydown:')\" title=\"Enemy debuff arrow\" class=\"btn-icon-tool\" style=\"color:#FFFF00; font-size: 12px; padding: 2px 4px; flex: 1;\">↓</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':once:')\" title=\"Once only\" class=\"btn-icon-tool\" style=\"font-size: 12px; padding: 2px 4px; flex: 1;\">!</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':inf:')\" title=\"Infinite\" class=\"btn-icon-tool\" style=\"font-size: 12px; padding: 2px 4px; flex: 1;\">∞</button>\n                </div>\n                <!-- Text Area Shortcuts: Debuffs -->\n                <div style=\"display:flex; gap: 3px; width: 100%; flex-wrap:wrap;\">\n                    <button onclick=\"insertShortcut('input-sec-1', ':atk_down:')\" title=\"ATK Down\" class=\"btn-icon-tool\" style=\"color:#f87171; font-size: 9.5px; font-weight:bold; padding: 2px 4px; flex: 1; border-color:#ef4444;\">ATK↓</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':def_down:')\" title=\"DEF Down\" class=\"btn-icon-tool\" style=\"color:#38bdf8; font-size: 9.5px; font-weight:bold; padding: 2px 4px; flex: 1; border-color:#3b82f6;\">DEF↓</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':stun:')\" title=\"Stun\" class=\"btn-icon-tool\" style=\"color:#facc15; font-size: 9.5px; font-weight:bold; padding: 2px 4px; flex: 1; border-color:#eab308;\">Stun</button>\n                    <button onclick=\"insertShortcut('input-sec-1', ':seal:'