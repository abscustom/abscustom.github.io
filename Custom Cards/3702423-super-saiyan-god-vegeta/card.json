    "<div class=\"row sa-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <div class=\"col\">\n                    <div class=\"row padding-top-bottom-10 bg-agl dokkan-card\">\n                      <div class=\"col-sm-2\"><b><span class=\"sa-type-label\">Super Attack</span></b></div>\n                      <div class=\"col-sm-8\" style=\"display: flex; justify-content: center; align-items: center;\">\n                        <!-- Use Classes here -->\n                        <img class=\"sa-display-icon\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_01.png\">\n                        <b class=\"sa-display-name\">God Breaker</b>\n                      </div>\n                    </div>\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 dokkan-card\">\n                      <div class=\"col padding-top-bottom-5\">\n                        <div class=\"sa-display-effects-list\"><div class=\"row\"><div class=\"col\">Greatly raises ATK &amp; DEF, causes immense damage and disables enemy's action once within the turn</div></div></div>\n\n                        <!-- 1. ACTIVATION CONDITION (Hidden by default, shows above SA logo when active) -->\n                        <div class=\"activation-row d-none\">\n                          <hr class=\"divider py bg-secondary\">\n                          <div class=\"row\">\n                            <div class=\"col text-center italic py-1\">\n                              <div class=\"activation-text\">Activation Conditions</div>\n                            </div>\n                          </div>\n                        </div>\n\n                        <!-- 2. SA STATS LOGO (Always visible, stays below activation text) -->\n                        <div class=\"row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                            <div class=\"stats-container row\"><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"99 turns\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0001.png\"><span class=\"display-text ms-1\">50%</span></div><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"99 turns\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0002.png\"><span class=\"display-text ms-1\">50%</span></div><div class=\"col sa-stat-row\" data-target=\"enemy\" data-turns=\"1 turn\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_1009.png\"><span class=\"display-text ms-1\">100%</span></div></div>\n                          </div>\n                        </div>\n\n                        <!-- 3. SA LV 20 TEXT (Below SA Logo by default, hides when Activation toggled on) -->\n                        <div class=\"sa-lv-container\">\n                          <div class=\"row sa-20-bonus\" style=\"display: none;\">\n                            <div class=\"col\">\n                              <hr class=\"divider py bg-secondary\">\n                              <div class=\"text-center py-1\">SA Lv 20: Super Attack +30%</div>\n                            </div>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div>\n                  </div>\n                </div>",
    "<div class=\"row sa-block font-size-1_2 margin-top-bottom-5 justify-content-center align-items-center border border-2 border-agl dokkan-card\">\n                  <div class=\"col\">\n                    <div class=\"row padding-top-bottom-10 bg-agl dokkan-card\">\n                      <div class=\"col-sm-2\"><b><span class=\"sa-type-label\">EX Super Attack</span></b></div>\n                      <div class=\"col-sm-8\" style=\"display: flex; justify-content: center; align-items: center;\">\n                        <!-- Use Classes here -->\n                        <img class=\"sa-display-icon\" src=\"https://abscustom.github.io/assets/images/sp_skill_icon_etc.png\">\n                        <b class=\"sa-display-name\">God Heat Flash</b>\n                      </div>\n                    </div>\n                    <div class=\"row padding-top-bottom-5 bg-agl-2 dokkan-card\">\n                      <div class=\"col padding-top-bottom-5\">\n                        <div class=\"sa-display-effects-list\"><div class=\"row\"><div class=\"col\">Raises ATK by 140% for 4 turns, raises DEF for 1 turn and causes causes ultimate damage to enemy</div></div></div>\n\n                        <!-- 1. ACTIVATION CONDITION (Hidden by default, shows above SA logo when active) -->\n                        <div class=\"activation-row\">\n                          <hr class=\"divider py bg-secondary\">\n                          <div class=\"row\">\n                            <div class=\"col text-center italic py-1\">\n                              <div class=\"activation-text\"><strong>Activation Condition</strong><br>When the 1st attack in the turn is a Super Attack, 80% chance for the Super Attack to become an EX Super Attack</div>\n                            </div>\n                          </div>\n                        </div>\n\n                        <!-- 2. SA STATS LOGO (Always visible, stays below activation text) -->\n                        <div class=\"row\">\n                          <div class=\"col\">\n                            <hr class=\"divider py bg-secondary\">\n                            <div class=\"stats-container row\"><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"4 turns\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0001.png\"><span class=\"display-text ms-1\">140%</span></div><div class=\"col sa-stat-row\" data-target=\"self\" data-turns=\"1 turn\"><img class=\"display-img\" width=\"50\" src=\"https://abscustom.github.io/assets/images/st_0002.png\"><span class=\"display-text ms-1\">30%</span></div></div>\n                          </div>\n                        </div>\n\n                        <!-- 3. SA LV 20 TEXT (Below SA Logo by default, hides when Activation toggled on) -->\n                        <div class=\"sa-lv-container d-none\">\n                          <div class=\"row sa-20-bonus\" style=\"display: none;\">\n                            <div class=\"col\">\n                              <hr class=\"divider py bg-secondary\">\n                              <div class=\"text-center py-1\">SA Lv 20: Super Attack +30%</div>\n                            </div>\n                          </div>\n                        </div>\n\n                      </div>\n                    </div>\n                  </div>\n                </div>"
